<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#102a43" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="SRTorneos" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["SRTorneos.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script>
        // Evita envíos dobles: desactiva el botón justo después de enviar (el navegador ya tomó su valor).
        document.addEventListener('submit', function (e) {
            var boton = e.submitter;
            if (boton) setTimeout(function () { boton.disabled = true; }, 0);
        });
        // Si el usuario regresa con "Atrás", vuelve a habilitar los botones.
        window.addEventListener('pageshow', function () {
            document.querySelectorAll('button[type=submit][disabled]').forEach(function (b) { b.disabled = false; });
        });

        // Clave del equipo: mientras escribes el nombre se muestra la sugerencia (si dejas el campo vacío, el servidor la asigna).
        document.addEventListener('input', function (e) {
            var nombre = e.target;
            if (nombre.id) {
                document.querySelectorAll('[data-clave-de="' + nombre.id + '"]').forEach(function (clave) {
                    var menores = ['DE', 'DEL', 'LA', 'LAS', 'EL', 'LOS', 'Y', 'FC', 'CF', 'CLUB'];
                    var palabras = nombre.value.normalize('NFD').toUpperCase().replace(/[^A-Z0-9 ]/g, '').split(' ').filter(function (p) { return p; });
                    var importantes = palabras.filter(function (p) { return menores.indexOf(p) < 0; });
                    clave.placeholder = ((importantes[0] || palabras[0] || 'HAL').substring(0, 3));
                });
            }
            if (nombre.classList && nombre.classList.contains('input-clave')) {
                var posicion = nombre.selectionStart;
                nombre.value = nombre.value.normalize('NFD').toUpperCase().replace(/[^A-Z0-9]/g, '').substring(0, 3);
                try { nombre.setSelectionRange(posicion, posicion); } catch (x) { }
            }
        });

        // Botón flotante «＋» y edición en celular: lleva directo al formulario.
        function irAFormulario(enfocar) {
            var formulario = document.getElementById('formulario');
            if (!formulario) return;
            formulario.scrollIntoView({ behavior: 'smooth', block: 'start' });
            if (enfocar) {
                var campo = formulario.querySelector('input:not([type=hidden]), select, textarea');
                if (campo) setTimeout(function () { campo.focus({ preventScroll: true }); }, 350);
            }
        }
        function alCargar() {
            if (window.innerWidth < 1320 && /[?&]editar=/.test(location.search)) irAFormulario(false);
        }
        document.addEventListener('DOMContentLoaded', alCargar);
        if (window.Blazor && Blazor.addEventListener) Blazor.addEventListener('enhancedload', alCargar);

        document.addEventListener('click', function (e) {
            var ir = e.target.closest('[data-ir-a]');
            if (ir) { e.preventDefault(); irAFormulario(true); return; }

            // Compartir: menú nativo del celular si existe; si no, el enlace abre WhatsApp.
            var compartir = e.target.closest('[data-compartir]');
            if (compartir && navigator.share) {
                e.preventDefault();
                navigator.share({ title: document.title, text: compartir.dataset.texto, url: compartir.dataset.url }).catch(function () { });
                return;
            }

            // Seguir torneo: lista de ids en una cookie del navegador (no se guarda en la base de datos).
            var seguir = e.target.closest('[data-seguir]');
            if (seguir) {
                var id = seguir.dataset.seguir;
                var actual = (document.cookie.split('; ').find(function (c) { return c.indexOf('srt_sigo=') === 0; }) || 'srt_sigo=').substring(9);
                var ids = actual.split('-').filter(function (x) { return x && x !== id; });
                var activo = !seguir.classList.contains('is-on');
                if (activo) ids.push(id);
                document.cookie = 'srt_sigo=' + ids.slice(-100).join('-') + '; path=/; max-age=31536000; samesite=lax';
                document.querySelectorAll('[data-seguir="' + id + '"]').forEach(function (b) {
                    b.classList.toggle('is-on', activo);
                    b.setAttribute('aria-pressed', activo ? 'true' : 'false');
                });
            }
        });
    </script>
</body>

</html>
