@* Barra de navegación inferior (solo en celular), como en las apps deportivas. *@
<nav class="tabbar" aria-label="Navegación principal">
    <NavLink class="tabbar__item" href="" Match="NavLinkMatch.All">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 11.5 12 4l9 7.5M5.5 9.5V20h13V9.5" /></svg><span>Inicio</span>
    </NavLink>
    <NavLink class="tabbar__item" href="partidos">
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="5" width="17" height="15" rx="2" /><path d="M3.5 10h17M8 3v4M16 3v4" /></svg><span>Partidos</span>
    </NavLink>
    <NavLink class="tabbar__item" href="torneos">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 4h8v5a4 4 0 0 1-8 0V4ZM8 6H4.5a3.5 3.5 0 0 0 3.6 4M16 6h3.5a3.5 3.5 0 0 1-3.6 4M12 13v4M8.5 20h7M10 17h4" /></svg><span>Torneos</span>
    </NavLink>
    <NavLink class="tabbar__item" href="canchas">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21Z" /><circle cx="12" cy="9.5" r="2.5" /></svg><span>Canchas</span>
    </NavLink>
    @if (EsAdmin)
    {
        <NavLink class="tabbar__item" href="admin">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg><span>Admin</span>
        </NavLink>
    }
    else
    {
        <NavLink class="tabbar__item" href="login">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="3.5" /><path d="M5 20a7 7 0 0 1 14 0" /></svg><span>Entrar</span>
        </NavLink>
    }
</nav>

@code {
    [CascadingParameter] public HttpContext? HttpContext { get; set; }
    private bool EsAdmin => HttpContext?.User.Identity?.IsAuthenticated == true;
}
