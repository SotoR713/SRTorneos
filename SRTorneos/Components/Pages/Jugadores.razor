@page "/jugadores"
@attribute [Authorize]
@inherits JugadoresBase

<PageTitle>SRTorneos | Jugadores</PageTitle>

<section class="page-heading">
    <div><p class="eyebrow text-accent">CATÁLOGO</p><h1>Jugadores</h1><p>Todos los jugadores registrados. Para meterlos a un equipo ve a la plantilla del equipo dentro del torneo.</p></div>
</section>

<Avisos Aviso="@Aviso" Error="@Error" />

<div class="split-layout">
    <section class="panel">
        <header class="panel__header">
            <h2>Jugadores <span class="count-pill">@Lista.Count</span></h2>
            <form method="get" action="jugadores" class="inline-form search-form">
                <input class="form-control" type="search" name="q" value="@Busqueda" placeholder="Buscar por nombre…" maxlength="50" aria-label="Buscar jugador" />
                <button class="btn btn-light" type="submit">Buscar</button>
            </form>
        </header>

        <form method="post" @formname="eliminar-jugador" @onsubmit="EliminarAsync">
        <AntiforgeryToken />
        @if (Lista.Count == 0)
        {
            <p class="panel__empty">@(string.IsNullOrWhiteSpace(Busqueda) ? "Aún no hay jugadores registrados." : $"No hay jugadores que coincidan con «{Busqueda}».")</p>
        }
        else
        {
                <div class="table-responsive">
                    <table class="data-table tabla-tarjetas">
                        <thead><tr><th class="num">#</th><th>Jugador</th><th>Posición</th><th class="num">Torneos</th><th class="num">Puntos</th><th class="num">Faltas</th><th class="actions"></th></tr></thead>
                        <tbody>
                            @foreach (var jugador in Lista)
                            {
                                <tr class="@(jugador.Id == Editar ? "is-editing" : null)">
                                    <td class="num celda-camiseta"><span class="jersey">@jugador.Numero</span></td>
                                    <td class="row-title celda-titulo">@jugador.Nombre</td>
                                    <td data-label="Posición">@jugador.Posicion</td>
                                    <td class="num" data-label="Torneos">@jugador.Torneos</td>
                                    <td class="num" data-label="Puntos">@jugador.Puntos</td>
                                    <td class="num" data-label="Faltas">@jugador.Faltas</td>
                                    <td class="actions">
                                        <a class="btn btn-sm btn-light" href="jugadores?editar=@jugador.Id">Editar</a>
                                        @if (jugador.SePuedeEliminar)
                                        {
                                            <button class="btn btn-sm btn-outline-danger" type="submit" name="EliminarId" value="@jugador.Id"
                                                    onclick="return confirm('¿Eliminar este jugador?');">Eliminar</button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
        }
        </form>
    </section>

    <a class="fab" href="@($"{Navegacion.ToBaseRelativePath(Navegacion.Uri).Split('#')[0]}#formulario")" data-ir-a="formulario">＋ Jugador</a>

    <section class="panel panel--form" id="formulario">
        <header class="panel__header"><h2>@(EnEdicion ? "Editar jugador" : "Nuevo jugador")</h2></header>
        @if (EnEdicion)
        {
            <p class="panel__hint">Los cambios se reflejan en todos los torneos donde juega.</p>
        }
        @if (FormJugador is not null)
        {
            <EditForm Model="FormJugador" FormName="jugador" OnValidSubmit="GuardarAsync">
                <DataAnnotationsValidator />
                <input type="hidden" name="FormJugador.Id" value="@FormJugador.Id" />
                <div class="form-grid form-grid--numero">
                    <div class="form-field"><label for="numero">Número</label><InputNumber id="numero" class="form-control" @bind-Value="FormJugador.Numero" min="0" max="999" /><ValidationMessage For="@(() => FormJugador.Numero)" /></div>
                    <div class="form-field"><label for="nombre">Nombre</label><InputText id="nombre" class="form-control" @bind-Value="FormJugador.Nombre" maxlength="50" /><ValidationMessage For="@(() => FormJugador.Nombre)" /></div>
                </div>
                <div class="form-field"><label for="posicion">Posición</label><InputText id="posicion" class="form-control" @bind-Value="FormJugador.Posicion" maxlength="20" /><ValidationMessage For="@(() => FormJugador.Posicion)" /></div>
                <div class="form-actions">
                    @if (EnEdicion) { <a class="btn btn-light" href="jugadores">Cancelar</a> }
                    <button class="btn btn-accent" type="submit">@(EnEdicion ? "Guardar" : "Crear jugador")</button>
                </div>
            </EditForm>
        }
    </section>
</div>
