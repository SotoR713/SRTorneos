@page "/torneos/nuevo"
@inherits NuevoTorneoBase
@rendermode InteractiveServer

<PageTitle>SRTorneos | Nuevo torneo</PageTitle>

<section class="page-heading compact-heading">
    <div><p class="eyebrow text-accent">NUEVA COMPETENCIA</p><h1>Crear torneo</h1><p>Completa la información inicial del torneo.</p></div>
    <a class="back-link" href="torneos">← Volver a torneos</a>
</section>

<section class="form-card">
@if (CargandoCatalogos)
{
    <p class="loading-state">Conectando con SRTorneosBD...</p>
}
else
{
    <EditForm Model="Formulario" OnValidSubmit="GuardarAsync">
        <DataAnnotationsValidator />
        <ValidationSummary class="validation-summary" />
        <div class="form-grid">
            <div class="form-field full-width"><label for="nombre">Nombre del torneo</label><InputText id="nombre" class="form-control" @bind-Value="Formulario.Nombre" placeholder="Ej. Liga universitaria 2026" /><ValidationMessage For="@(() => Formulario.Nombre)" /></div>
            <div class="form-field"><label for="inicio">Fecha de inicio</label><InputDate id="inicio" class="form-control" @bind-Value="Formulario.FechaInicio" /><ValidationMessage For="@(() => Formulario.FechaInicio)" /></div>
            <div class="form-field"><label for="fin">Fecha de fin</label><InputDate id="fin" class="form-control" @bind-Value="Formulario.FechaFin" /><ValidationMessage For="@(() => Formulario.FechaFin)" /></div>
            <div class="form-field"><label for="deporte">Deporte</label><InputSelect id="deporte" class="form-select" @bind-Value="Formulario.IdDeporte"><option value="0">Selecciona un deporte</option>@foreach (var deporte in Deportes) { <option value="@deporte.Id">@deporte.Nombre</option> }</InputSelect><ValidationMessage For="@(() => Formulario.IdDeporte)" /></div>
            <div class="form-field"><label for="usuario">Creador</label><InputSelect id="usuario" class="form-select" @bind-Value="Formulario.IdUsuario"><option value="0">Selecciona un usuario</option>@foreach (var usuario in Usuarios) { <option value="@usuario.Id">@usuario.UserName</option> }</InputSelect><ValidationMessage For="@(() => Formulario.IdUsuario)" /></div>
            <div class="form-field full-width"><label for="tipoTorneo">Tipo de torneo</label><InputSelect id="tipoTorneo" class="form-select" @bind-Value="Formulario.IdTipoTorneo"><option value="0">Selecciona un tipo</option>@foreach (var tipo in TiposTorneo) { <option value="@tipo.Id">@tipo.Nombre</option> }</InputSelect><ValidationMessage For="@(() => Formulario.IdTipoTorneo)" /></div>
        </div>
        @if (!string.IsNullOrWhiteSpace(Mensaje))
        {
            <div class="alert alert-warning mt-4 mb-0" role="alert">
                <strong>@Mensaje</strong>
                @if (!string.IsNullOrWhiteSpace(DetalleError)) { <div class="mt-2 small">Detalle de SQL: @DetalleError</div> }
            </div>
        }
        <div class="form-actions"><a class="btn btn-light" href="torneos">Cancelar</a><button class="btn btn-accent" type="submit">Guardar torneo</button></div>
    </EditForm>
}
</section>
