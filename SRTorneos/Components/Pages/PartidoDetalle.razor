@page "/torneos/{Id:int}/partidos/{IdPartido:int}"
@inherits PartidoDetalleBase

<PageTitle>SRTorneos | @(Partido is null ? "Partido" : $"{Partido.Equipo1} vs {Partido.Equipo2}")</PageTitle>

@if (Torneo is null)
{
    <Avisos Error="@Error" />
}
else
{
    <TorneoEncabezado Torneo="Torneo" Seccion="partidos" />

    @if (Partido is null)
    {
        <Avisos Error="@Error" />
    }
    else
    {
        <a class="back-link" href="torneos/@Id/partidos">← Calendario</a>

        var (estado, claseEstado) = Presentacion.EstadoPartido(Partido);
        <section class="scoreboard">
            <a class="scoreboard__team @(Partido.GanoLocal ? "winner" : null)" href="torneos/@Id/equipos/@Partido.IdEquipo1">
                <Escudo Nombre="@Partido.Equipo1" Clave="@Partido.Clave1" Tamano="lg" />
                <strong>@Partido.Equipo1</strong><small>LOCAL</small>
            </a>
            <div class="scoreboard__score">
                <span class="chip @claseEstado">@estado</span>
                @if (Partido.Jugado)
                {
                    <div class="scoreboard__numbers"><span>@Partido.Puntos1</span><em>–</em><span>@Partido.Puntos2</span></div>
                }
                else
                {
                    <div class="scoreboard__numbers scoreboard__numbers--time">@Presentacion.Hora(Partido.Fecha)</div>
                }
                <small>@Presentacion.FechaHora(Partido.Fecha)</small>
            </div>
            <a class="scoreboard__team @(Partido.GanoVisitante ? "winner" : null)" href="torneos/@Id/equipos/@Partido.IdEquipo2">
                <Escudo Nombre="@Partido.Equipo2" Clave="@Partido.Clave2" Tamano="lg" />
                <strong>@Partido.Equipo2</strong><small>VISITANTE</small>
            </a>
        </section>
        <div class="action-row">
            <a class="btn-pill" href="canchas/@Partido.IdLugar">📍 @Partido.Lugar</a>
            <BotonCompartir Texto="@Presentacion.TextoPartido(Partido)" Ruta="@($"torneos/{Id}/partidos/{IdPartido}")" />
            @if (!Partido.Jugado)
            {
                <a class="btn-pill" href="torneos/@Id/partidos/@IdPartido/calendario.ics" download data-enhance-nav="false">📅 Agregar al calendario</a>
            }
        </div>

        <Avisos Aviso="@Aviso" Error="@Error" />

        <section class="panel">
            <header class="panel__header">
                <h2>@(EsAdmin ? "Resultado" : "Estadísticas del partido")</h2>
                @if (EsAdmin) { <a href="torneos/@Id/partidos?editar=@Partido.Id">Cambiar fecha, equipos o lugar →</a> }
            </header>

            @if (!EsAdmin)
            {
                <div class="result-grid">
                    @foreach (var (idEquipo, nombre, esLocal) in Lados)
                    {
                        <div class="result-team">
                            <div class="result-team__head">
                                <h3><Escudo Nombre="@nombre" Clave="@(idEquipo == Partido.IdEquipo1 ? Partido.Clave1 : Partido.Clave2)" Tamano="xs" /> @nombre</h3>
                                <span class="score-readonly">@((esLocal ? Partido.Puntos1 : Partido.Puntos2)?.ToString() ?? "–")</span>
                            </div>
                            @if (JugadoresDe(idEquipo).Count == 0)
                            {
                                <p class="panel__empty">Sin jugadores registrados.</p>
                            }
                            else
                            {
                                <table class="data-table data-table--compact">
                                    <thead><tr><th class="num">#</th><th>Jugador</th>@foreach (var tipo in TiposAnotacion) { <th class="num" title="@tipo.Nombre">@tipo.Abreviatura</th> }<th class="num">Pts</th></tr></thead>
                                    <tbody>
                                        @foreach (var fila in FormResultado!.Anotaciones!.Where(f => JugadoresPorId.TryGetValue(f.IdJugador, out var j) && j.IdEquipo == idEquipo))
                                        {
                                            var jugador = JugadoresPorId[fila.IdJugador];
                                            <tr>
                                                <td class="num"><span class="jersey">@jugador.Numero</span></td>
                                                <td><a class="row-title" href="torneos/@Id/jugadores/@jugador.IdJugador">@jugador.Nombre</a></td>
                                                @for (int k = 0; k < TiposAnotacion.Count; k++) { <td class="num">@fila.Cantidad(k)</td> }
                                                <td class="num"><strong>@fila.Puntos(TiposAnotacion)</strong></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
            @if (FormResultado is not null)
            {
                <EditForm Model="FormResultado" FormName="resultado" OnValidSubmit="GuardarResultadoAsync">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="validation-summary" />

                    <div class="result-grid">
                        @foreach (var (idEquipo, nombre, esLocal) in Lados)
                        {
                            <div class="result-team">
                                <div class="result-team__head">
                                    <h3>@nombre</h3>
                                    @if (esLocal)
                                    {
                                        <InputNumber class="form-control score-input" @bind-Value="FormResultado.Puntos1" min="0" max="999" aria-label="@($"Puntos de {nombre}")" />
                                    }
                                    else
                                    {
                                        <InputNumber class="form-control score-input" @bind-Value="FormResultado.Puntos2" min="0" max="999" aria-label="@($"Puntos de {nombre}")" />
                                    }
                                </div>

                                @if (JugadoresDe(idEquipo).Count == 0)
                                {
                                    <p class="panel__empty">Sin jugadores en la plantilla. <a href="torneos/@Id/equipos/@idEquipo">Agregar jugadores</a></p>
                                }
                                else if (TiposAnotacion.Count > 0)
                                {
                                    <table class="data-table data-table--compact">
                                        <thead>
                                            <tr>
                                                <th class="num">#</th><th>Jugador</th>
                                                @foreach (var tipo in TiposAnotacion) { <th class="num" title="@tipo.Nombre (@tipo.Valor pts)">@tipo.Abreviatura</th> }
                                                <th class="num">Pts</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @for (int i = 0; i < FormResultado.Anotaciones!.Count; i++)
                                            {
                                                var indice = i;
                                                var fila = FormResultado.Anotaciones![indice];
                                                if (!JugadoresPorId.TryGetValue(fila.IdJugador, out var jugador) || jugador.IdEquipo != idEquipo) continue;
                                                fila.Cantidades ??= [];
                                                while (fila.Cantidades.Count < TiposAnotacion.Count) { fila.Cantidades.Add(null); }
                                                <tr>
                                                    <td class="num"><span class="jersey">@jugador.Numero</span></td>
                                                    <td>@jugador.Nombre<input type="hidden" name="FormResultado.Anotaciones[@indice].IdJugador" value="@fila.IdJugador" /></td>
                                                    @for (int k = 0; k < TiposAnotacion.Count; k++)
                                                    {
                                                        var columna = k;
                                                        <td class="num"><input type="number" class="form-control form-control-sm count-input" name="@($"FormResultado.Anotaciones[{indice}].Cantidades[{columna}]")" value="@fila.Cantidades![columna]" min="0" max="99" aria-label="@($"{TiposAnotacion[columna].Nombre} de {jugador.Nombre}")" /></td>
                                                    }
                                                    <td class="num"><strong>@fila.Puntos(TiposAnotacion)</strong></td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                }
                            </div>
                        }
                    </div>

                    @if (TiposAnotacion.Count > 0)
                    {
                        <p class="field-hint">
                            Por jugador captura cuántos @(Presentacion.ListaNatural(TiposAnotacion.Select(t => $"{t.Nombre.ToLowerInvariant()} ({t.Valor} pts)"))) hizo. Es opcional y su suma no puede superar el marcador del equipo.
                            @if (TiposSinRegistro.Count > 0)
                            {
                                <span>Los @(Presentacion.ListaNatural(TiposSinRegistro.Select(t => t.Nombre.ToLowerInvariant()))) no se registran por jugador (tu base solo acepta anotaciones de @(Presentacion.ListaNatural(ReglasAnotacion.ValoresPermitidos.OrderByDescending(v => v).Select(v => v.ToString()), "o")) puntos); inclúyelos solo en el marcador.</span>
                            }
                        </p>
                    }
                    else
                    {
                        <p class="field-hint">Tu base de datos no acepta anotaciones por jugador para @Torneo.Deporte (CK_Anotacion_Puntos). Solo se guarda el marcador de cada equipo.</p>
                    }

                    <div class="form-actions">
                        <button class="btn btn-accent" type="submit">Guardar resultado</button>
                    </div>
                </EditForm>

                <form method="post" @formname="borrar-resultado" @onsubmit="BorrarResultadoAsync" class="text-end mt-2">
                    <AntiforgeryToken />
                    @if (Partido.Jugado)
                    {
                        <button class="btn btn-link text-danger" type="submit" onclick="return confirm('¿Borrar el resultado? El partido volverá a quedar pendiente.');">Borrar resultado</button>
                    }
                </form>
            }
            }
        </section>

        <section class="panel">
            <header class="panel__header"><h2>Faltas <span class="count-pill">@Faltas.Count</span></h2></header>

            @if (EsAdmin && FormFalta is not null)
            {
                <EditForm Model="FormFalta" FormName="falta" OnValidSubmit="RegistrarFaltaAsync" class="inline-form inline-form--wrap">
                @if (TiposFalta.Count == 0)
                {
                    <p class="panel__empty">Para registrar faltas agrega al menos un <a href="catalogos/tipos-falta">tipo de falta</a>.</p>
                }
                else if (JugadoresPorId.Count == 0)
                {
                    <p class="panel__empty">Agrega jugadores a las plantillas de los equipos para registrar faltas.</p>
                }
                else
                {
                    <DataAnnotationsValidator />
                    <InputSelect class="form-select" @bind-Value="FormFalta.IdJugador" aria-label="Jugador">
                        <option value="0">Jugador…</option>
                        @foreach (var (idEquipo, nombre, _) in Lados)
                        {
                            <optgroup label="@nombre">
                                @foreach (var jugador in JugadoresDe(idEquipo)) { <option value="@jugador.IdJugador">#@jugador.Numero @jugador.Nombre</option> }
                            </optgroup>
                        }
                    </InputSelect>
                    <InputSelect class="form-select" @bind-Value="FormFalta.IdTipoFalta" aria-label="Tipo de falta">
                        <option value="0">Tipo de falta…</option>
                        @foreach (var tipo in TiposFalta) { <option value="@tipo.Id">@tipo.Nombre</option> }
                    </InputSelect>
                    <button class="btn btn-accent" type="submit">Registrar falta</button>
                    <ValidationSummary class="validation-summary w-100" />
                }
                </EditForm>
            }

            <form method="post" @formname="eliminar-falta" @onsubmit="EliminarFaltaAsync">
                <AntiforgeryToken />
                @if (Faltas.Count > 0)
                {
                    <div class="table-responsive mt-3">
                    <table class="data-table data-table--compact">
                        <thead><tr><th class="num">#</th><th>Jugador</th><th>Equipo</th><th>Tipo</th><th class="actions"></th></tr></thead>
                        <tbody>
                            @foreach (var falta in Faltas)
                            {
                                <tr>
                                    <td class="num"><span class="jersey">@falta.Numero</span></td>
                                    <td>@falta.Jugador</td>
                                    <td>@falta.Equipo</td>
                                    <td><span class="badge-soft badge-soft--warn">@falta.TipoFalta</span></td>
                                    <td class="actions">@if (EsAdmin) { <button class="btn btn-sm btn-link text-danger" type="submit" name="EliminarIdFalta" value="@falta.Id" onclick="return confirm('¿Quitar esta falta?');">Quitar</button> }</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    </div>
                }
            </form>
        </section>
    }
}
