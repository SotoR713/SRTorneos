@page "/torneos/{Id:int}"
@inherits TorneoDetalleBase

<PageTitle>SRTorneos | @(Torneo?.Nombre ?? "Torneo")</PageTitle>

@if (Torneo is null)
{
    <Avisos Error="@Error" />
}
else
{
    <TorneoEncabezado Torneo="Torneo" Seccion="resumen" />
    <Avisos Aviso="@Aviso" Error="@Error" />
    @if (EsAdmin && Torneo.PuntosVict is null && Torneo.EquiposMax is null)
    {
        <div class="alert alert-warning">Este torneo no tiene sus reglas (tipo, puntos por victoria y cupo). <a href="torneos/@Torneo.Id/editar">Edítalo y guarda</a> para registrarlas; mientras tanto se usan @Torneo.PuntosVictoria puntos por victoria y sin límite de equipos.</div>
    }
    @if (EsAdmin && Torneo.TipoPareceEliminatoria)
    {
        <div class="alert alert-info">El tipo «@Torneo.TipoTorneo» se juega como liga (todos contra todos): la base de datos todavía no guarda rondas ni llaves.</div>
    }

    <section class="stat-grid">
        <div class="stat-card"><small>Equipos</small><strong>@Torneo.Equipos<span class="stat-of">/ @(Torneo.EquiposMax?.ToString() ?? "—")</span></strong></div>
        <div class="stat-card"><small>Jugadores</small><strong>@Torneo.Jugadores</strong></div>
        <div class="stat-card"><small>Partidos jugados</small><strong>@Torneo.PartidosJugados<span class="stat-of">/ @Torneo.Partidos</span></strong></div>
        <div class="stat-card"><small>Puntos por victoria</small><strong>@Torneo.PuntosVictoria</strong></div>
        <div class="stat-card"><small>Creado por</small><strong>@Torneo.Creador</strong></div>
    </section>

    @if (Campeon is not null)
    {
        <section class="champion-banner">
            <span class="champion-banner__icon">🏆</span>
            <div><small>CAMPEÓN</small><strong>@Campeon</strong></div>
        </section>
    }

    @if (EsAdmin && Torneo.Equipos < 2)
    {
        <section class="next-step">
            <span class="quick-icon">1</span>
            <div><strong>Inscribe al menos dos equipos</strong><small>Después podrás cargar sus plantillas y armar el calendario.</small></div>
            <a class="btn btn-accent" href="torneos/@Torneo.Id/equipos">Inscribir equipos</a>
        </section>
    }
    else if (EsAdmin && Torneo.Partidos == 0)
    {
        <section class="next-step">
            <span class="quick-icon">2</span>
            <div><strong>Genera el calendario</strong><small>Todos contra todos, con jornadas, canchas y horarios repartidos de forma justa.</small></div>
            <a class="btn btn-accent" href="torneos/@Torneo.Id/partidos/generar">Generar calendario</a>
        </section>
    }

    <div class="panel-grid">
        <section class="feed-section">
            <header class="feed-section__head"><h2>Próximos partidos</h2><a href="torneos/@Torneo.Id/partidos">Ver todos</a></header>
            @if (Proximos.Count == 0)
            {
                <p class="panel__empty">No hay partidos pendientes.</p>
            }
            <div class="match-grid match-grid--1">@foreach (var partido in Proximos) { <TarjetaPartido Partido="partido" /> }</div>
        </section>

        <section class="feed-section">
            <header class="feed-section__head"><h2>Últimos resultados</h2><a href="torneos/@Torneo.Id/posiciones">Posiciones</a></header>
            @if (Recientes.Count == 0)
            {
                <p class="panel__empty">Aún no hay resultados capturados.</p>
            }
            <div class="match-grid match-grid--1">@foreach (var partido in Recientes) { <TarjetaPartido Partido="partido" /> }</div>
        </section>

        <section class="leader-card leader-card--panel">
            <header><h2>Líderes de anotación</h2><a href="torneos/@Torneo.Id/estadisticas">Estadísticas</a></header>
            @if (Lideres.Count == 0)
            {
                <p class="leader-card__empty">Captura los puntos por jugador en los resultados para ver a los líderes.</p>
            }
            else
            {
                <ol>
                    @foreach (var anotador in Lideres)
                    {
                        <li>
                            <a href="torneos/@Torneo.Id/jugadores/@anotador.IdJugador">
                                <Escudo Nombre="@anotador.Equipo" Clave="@anotador.EquipoClave" Tamano="xs" />
                                <span class="leader-card__name">@anotador.Nombre<small>#@anotador.Numero · @anotador.Equipo · @Presentacion.Decimal(anotador.Promedio) por partido</small></span>
                                <b>@anotador.Puntos</b>
                            </a>
                        </li>
                    }
                </ol>
            }
        </section>
    </div>
}
