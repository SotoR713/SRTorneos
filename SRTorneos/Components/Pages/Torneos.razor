@page "/torneos"
@inherits TorneosBase

<PageTitle>SRTorneos | Torneos</PageTitle>

<section class="page-heading">
    <div><p class="eyebrow text-accent">MIS COMPETENCIAS</p><h1>Torneos</h1><p>Consulta y administra los torneos que hayas creado.</p></div>
    <a class="btn btn-accent" href="torneos/nuevo">＋ Nuevo torneo</a>
</section>

@if (Cargando)
{
    <div class="loading-state">Cargando torneos...</div>
}
else if (!string.IsNullOrWhiteSpace(ErrorCarga))
{
    <div class="alert alert-danger" role="alert">@ErrorCarga</div>
}
else if (Torneos.Count == 0)
{
    <section class="empty-state"><div class="empty-ball">🏀</div><h2>Aún no hay torneos</h2><p>Crea tu primer torneo para comenzar a registrar equipos, jugadores y partidos.</p><a class="btn btn-accent" href="torneos/nuevo">Crear mi primer torneo</a></section>
}
else
{
    <section class="tournament-grid" aria-label="Lista de torneos">
        @foreach (var torneo in Torneos)
        {
            <article class="tournament-card">
                <div class="tournament-card__top"><span class="tournament-icon">🏀</span><span class="badge-soft">Activo</span></div>
                <h2>@torneo.Nombre</h2>
                <p class="tournament-dates">@torneo.FechaInicio.ToString("dd MMM yyyy") — @torneo.FechaFin.ToString("dd MMM yyyy")</p>
                <a class="stretched-link tournament-link" href="#">Administrar torneo <span>→</span></a>
            </article>
        }
    </section>
}
